		"biketag-vue": {
			"path": "biketag-vue",
			"fileName": "biketag-vue",
			"wiki": "<p><span class=\"text-small\" style=\"color:#000000;\">BikeTag-Vue is a Vue 3-based web application designed to facilitate and enhance the \"BikeTag\" game. The app allows players to participate in location-based biking challenges where users post and discover bike-related tags. It integrates features like maps, achievements, and authentication.</span></p>",
			"visible": true
		},
		"NAfZICnAt9e7Of4MaGL6-1": {
			"path": "NAfZICnAt9e7Of4MaGL6-1",
			"wiki": "<p><span style=\"color:#0451a5;\">1.</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Frontend (Vue 3)**</strong></span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> The application’s UI is built using Vue 3.</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> Components are modular and located in </span><span style=\"color:#800000;\">`src/components/`</span><span style=\"color:#000000;\">.</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> Vue Router handles navigation (</span><span style=\"color:#800000;\">`src/router/index.ts`</span><span style=\"color:#000000;\">).</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> Pinia (depending on the implementation) manages global state (</span><span style=\"color:#800000;\">`src/store/`</span><span style=\"color:#000000;\">).</span></p>",
			"cellName": "Frontend",
			"cellId": "NAfZICnAt9e7Of4MaGL6-1",
			"visible": true
		},
		"Adg9fUx5eG60yKy4Ax7A-1": {
			"path": "Adg9fUx5eG60yKy4Ax7A-1",
			"wiki": "<p><span style=\"color:#0451a5;\">2.</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Backend (Serverless Functions on Netlify)**</strong></span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> Functions are written in TypeScript and found under </span><span style=\"color:#800000;\">`functions/`</span><span style=\"color:#000000;\">.</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> These include:</span></p><p style=\"margin-left:40px;\"><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#800000;\">`achievements.ts`</span><span style=\"color:#000000;\"> (handles achievements)</span></p><p style=\"margin-left:40px;\"><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#800000;\">`authorize.ts`</span><span style=\"color:#000000;\"> (handles authentication)</span></p><p style=\"margin-left:40px;\"><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#800000;\">`game.ts`</span><span style=\"color:#000000;\"> (core game logic)</span></p><p style=\"margin-left:40px;\"><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#800000;\">`players.ts`</span><span style=\"color:#000000;\"> (manages player data)</span></p><p style=\"margin-left:40px;\"><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#800000;\">`tags.ts`</span><span style=\"color:#000000;\"> (manages bike tags and locations)</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> Data storage likely relies on external APIs or cloud services.</span></p>",
			"cellName": "Backend",
			"cellId": "Adg9fUx5eG60yKy4Ax7A-1",
			"visible": true
		},
		"Adg9fUx5eG60yKy4Ax7A-2": {
			"path": "Adg9fUx5eG60yKy4Ax7A-2",
			"wiki": "<p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Imgur API**</strong></span><span style=\"color:#000000;\"> for image uploads (</span><span style=\"color:#800000;\">`IMGUR_CLIENT_ID`</span><span style=\"color:#000000;\"> in </span><span style=\"color:#800000;\">`.env`</span><span style=\"color:#000000;\">).</span></p><p>&nbsp;</p>",
			"cellName": "imgur",
			"cellId": "Adg9fUx5eG60yKy4Ax7A-2",
			"visible": true
		},
		"Adg9fUx5eG60yKy4Ax7A-3": {
			"path": "Adg9fUx5eG60yKy4Ax7A-3",
			"wiki": "<p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Google Maps API**</strong></span><span style=\"color:#000000;\"> for geolocation (</span><span style=\"color:#800000;\">`GOOGLE_API_KEY`</span><span style=\"color:#000000;\"> in </span><span style=\"color:#800000;\">`.env`</span><span style=\"color:#000000;\">).</span></p>",
			"cellName": "Google Maps API",
			"cellId": "Adg9fUx5eG60yKy4Ax7A-3",
			"visible": true
		},
		"Adg9fUx5eG60yKy4Ax7A-4": {
			"path": "Adg9fUx5eG60yKy4Ax7A-4",
			"wiki": "<p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Auth0**</strong></span><span style=\"color:#000000;\"> for authentication (</span><span style=\"color:#800000;\">`AUTH0_CLIENT_ID`</span><span style=\"color:#000000;\">, </span><span style=\"color:#800000;\">`AUTH0_DOMAIN`</span><span style=\"color:#000000;\">).</span></p>",
			"cellName": "Auth0",
			"cellId": "Adg9fUx5eG60yKy4Ax7A-4",
			"visible": true
		},
		"Adg9fUx5eG60yKy4Ax7A-5": {
			"path": "Adg9fUx5eG60yKy4Ax7A-5",
			"wiki": "<p><span style=\"color:#0451a5;\">3.</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Third-Party Integrations**</strong></span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Imgur API**</strong></span><span style=\"color:#000000;\"> for image uploads (</span><span style=\"color:#800000;\">`IMGUR_CLIENT_ID`</span><span style=\"color:#000000;\"> in </span><span style=\"color:#800000;\">`.env`</span><span style=\"color:#000000;\">).</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Google Maps API**</strong></span><span style=\"color:#000000;\"> for geolocation (</span><span style=\"color:#800000;\">`GOOGLE_API_KEY`</span><span style=\"color:#000000;\"> in </span><span style=\"color:#800000;\">`.env`</span><span style=\"color:#000000;\">).</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#000080;\"><strong>**Auth0**</strong></span><span style=\"color:#000000;\"> for authentication (</span><span style=\"color:#800000;\">`AUTH0_CLIENT_ID`</span><span style=\"color:#000000;\">, </span><span style=\"color:#800000;\">`AUTH0_DOMAIN`</span><span style=\"color:#000000;\">).</span></p>",
			"cellName": "Third-Party Integrations",
			"cellId": "Adg9fUx5eG60yKy4Ax7A-5",
			"visible": true
		},
