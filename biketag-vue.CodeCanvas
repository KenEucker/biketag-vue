					"simStepLabel": "2.2 - Display tags on map",
					"simStepDescription": "<p>2.2 - Display tags on map</p><p><span style=\"color:#000000;\">🔹 </span><span style=\"color:#000080;\"><strong>**What happens here?**</strong></span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> Alex can click on a tag to see details.</span></p>",
					"isEdge": false
				},
				{
					"simStepId": "f34ed072-e680-4f08-aaa6-e62407265ae4",
					"diagramNodeId": "Adg9fUx5eG60yKy4Ax7A-17",
					"simStepLabel": "Step 3: Alex takes a picture and submits it",
					"simStepDescription": "<p><span class=\"text-small\" style=\"color:#000080;\"><strong>**File:**</strong></span><span class=\"text-small\" style=\"color:#000000;\"> </span><span class=\"text-small\" style=\"color:#800000;\">`src/components/BikeTagCamera.vue`</span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> The camera component allows Alex to capture a new tag image and submit it.</span></p><p><br>&nbsp;</p>",
					"isEdge": false
				},
				{
					"simStepId": "6b294ae4-aa17-44d8-b8ce-fa4987b602b5",
					"diagramNodeId": "Adg9fUx5eG60yKy4Ax7A-14",
					"simStepLabel": "Step 4: System validates the image and assigns points**   **File:** `functions/tags.ts`",
					"simStepDescription": "<p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> The serverless function processes tag submissions.</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> It validates the image and updates the leaderboard.</span></p><p>&nbsp;</p><p><span style=\"color:#000000;\">🔹 </span><span style=\"color:#000080;\"><strong>**What happens here?**</strong></span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#800000;\">`validateImage()`</span><span style=\"color:#000000;\"> ensures the uploaded image meets game criteria.</span></p><p><span style=\"color:#0451a5;\">-</span><span style=\"color:#000000;\"> </span><span style=\"color:#800000;\">`updateLeaderboard()`</span><span style=\"color:#000000;\"> increases Alex's points.</span></p>",
					"isEdge": false
				},
				{
					"simStepId": "a58be577-a10f-404b-b71a-36165ba979ee",
					"diagramNodeId": "Adg9fUx5eG60yKy4Ax7A-18",
					"simStepLabel": "Step 5: Alex’s score updates on the leaderboard",
					"simStepDescription": "",
					"isEdge": false
				},
				{
					"simStepId": "93a3349d-0a97-4de6-9fe1-cced68ad2e95",
					"diagramNodeId": "Adg9fUx5eG60yKy4Ax7A-19",
					"simStepLabel": "Step 6: Alex, as an ambassador, approves or rejects tags",
					"simStepDescription": "<p><span class=\"text-small\" style=\"color:#000080;\"><strong>Step 6: Alex, as an ambassador, approves or rejects tags</strong></span></p><p><span class=\"text-small\" style=\"color:#000000;\">🔹 </span><span class=\"text-small\" style=\"color:#000080;\"><strong>**What happens here?**</strong></span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> Alex sees pending tag submissions.</span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> He can approve/reject tags.</span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> The app updates the status accordingly.</span></p>",
					"isEdge": false
				}
