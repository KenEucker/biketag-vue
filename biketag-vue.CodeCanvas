			"description": "<p><span style=\"color:#000000;\">BikeTag-Vue follows a </span><span style=\"color:#000080;\"><strong>**Vue 3 + TypeScript**</strong></span><span style=\"color:#000000;\"> architecture and uses </span><span style=\"color:#000080;\"><strong>**Vite**</strong></span><span style=\"color:#000000;\"> as its build tool. It is hosted on </span><span style=\"color:#000080;\"><strong>**Netlify**</strong></span><span style=\"color:#000000;\">, integrating backend serverless functions to handle game logic and data processing.</span></p>"
		},
		"Example Walkthrough": {
			"name": "Example Walkthrough",
			"simSteps": [
				{
					"simStepId": "d4135aef-394d-4f14-869d-18fc8f8e4d71",
					"diagramNodeId": "functions/authorize.ts-b77dae6d-c3a3-4743-9d09-cafd69e8298b",
					"simStepLabel": "Step 1: Alex logs in via Auth0",
					"simStepDescription": "<p><span class=\"text-small\" style=\"color:#800000;\"><strong>### </strong></span><span class=\"text-small\" style=\"color:#000080;\"><strong>**Step 1: Alex logs in via Auth0**</strong></span></p><p><span class=\"text-small\" style=\"color:#000080;\"><strong>**File:**</strong></span><span class=\"text-small\" style=\"color:#000000;\"> </span><span class=\"text-small\" style=\"color:#800000;\">`functions/authorize.ts`</span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> Auth0 handles authentication for the app.</span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> The </span><span class=\"text-small\" style=\"color:#800000;\">`authorize.ts`</span><span class=\"text-small\" style=\"color:#000000;\"> function validates the user's credentials and generates a token.</span></p><p><span class=\"text-small\" style=\"color:#000000;\">🔹 </span><span class=\"text-small\" style=\"color:#000080;\"><strong>**What happens here?**</strong></span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> The app verifies Alex's Auth0 JWT token.</span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> If valid, it returns Alex’s user details; otherwise, it rejects access.</span></p>",
					"isEdge": false
				},
				{
					"simStepId": "17a979bf-cf72-44e2-88ea-be58c49f6cfb",
					"diagramNodeId": "Adg9fUx5eG60yKy4Ax7A-16",
					"simStepLabel": "Step 2: Alex finds an active tag near his location",
					"simStepDescription": "<p><span class=\"text-small\" style=\"color:#000080;\"><strong>**File:**</strong></span><span class=\"text-small\" style=\"color:#000000;\"> </span><span class=\"text-small\" style=\"color:#800000;\">`src/components/BikeTagMap.vue`</span></p><p><span class=\"text-small\" style=\"color:#0451a5;\">-</span><span class=\"text-small\" style=\"color:#000000;\"> The component integrates with Google Maps API to display active tags.</span></p>",
					"isEdge": false
				},
