{% assign imageSize = 'l' %}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BikeTag notification</title><style>@media screen and (max-width:620px){.email-shell{width:100%!important}.email-shell td{box-sizing:border-box}}</style></head><body style="margin:0;padding:0;background:#eaf1f5;font-family:Arial,Helvetica,sans-serif"><div style="display:none;max-height:0;overflow:hidden;opacity:0">TAG APPROVED: BikeTag update.</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eaf1f5"><tr><td align="center" style="padding:24px 10px"><table class="email-shell" role="presentation" cellpadding="0" cellspacing="0" width="600" style="width:600px;max-width:100%;border-collapse:collapse"><tr><td align="center" style="background:#121b39;padding:26px 24px 12px;"><img src="{{ logo }}" alt="BikeTag" width="230" style="display:block;max-width:230px;width:100%;height:auto;border:0" /></td></tr><tr><td style="background:#ffffff;padding:0;"><img src="{{ host }}/images/email-illustrated-header.png" alt="BikeTag: ride, find, snap, repeat" width="600" style="display:block;width:100%;max-width:600px;height:auto" /></td></tr><tr><td style="background:#ffffff;padding:26px 32px;"><p style="margin:0 0 8px;color:#208bc5;letter-spacing:2px;font-size:12px;font-weight:bold">TAG APPROVED</p><h1 style="margin:0 0 12px;color:#121b39;font-size:34px;line-height:1.15">A submission was approved</h1><p style="margin:0;color:#283C4B;font-size:18px;line-height:1.6">{{ mainParagraphText }}</p></td></tr><tr><td style="background:#ffffff;padding:4px 22px 16px;"><table width="100%" role="presentation" cellpadding="0" cellspacing="0"><tr><td width="50%" valign="top" style="padding:7px"><p style="font-size:12px;color:#187db1;font-weight:bold;letter-spacing:1px">FOUND TAG</p>{% if foundImageUrl != blank %}<img src="{{ foundImageUrl | biketag_image: 'm' }}" alt="FOUND TAG" width="240" style="display:block;width:100%;max-width:240px;height:auto;border-radius:12px" />{% else %}<p style="font-size:14px;color:#283C4B">Photo unavailable. Open the queue to review this submission.</p>{% endif %}</td><td width="50%" valign="top" style="padding:7px"><p style="font-size:12px;color:#187db1;font-weight:bold;letter-spacing:1px">NEW MYSTERY</p>{% if mysteryImageUrl != blank %}<img src="{{ mysteryImageUrl | biketag_image: 'm' }}" alt="NEW MYSTERY" width="240" style="display:block;width:100%;max-width:240px;height:auto;border-radius:12px" />{% else %}<p style="font-size:14px;color:#283C4B">Photo unavailable. Open the queue to review this submission.</p>{% endif %}</td></tr></table></td></tr><tr><td style="background:#edf7fc;padding:18px 32px;"><p style="margin:0;font-size:14px;font-weight:bold;color:#121b39">{{ mainTitleText }}</p><p style="margin:8px 0 0;color:#283C4B;font-size:14px;line-height:1.5">{{ foundLocation }}<br>{{ foundTagBlurb }}</p></td></tr><tr><td style="background:#ffffff;padding:26px 32px;"><p style="margin:0;color:#283C4B;font-size:15px;line-height:1.6">{{ comparisonText }}</p></td></tr><tr><td style="background:#ffffff;padding:10px 32px 28px;"><a href="{{ ambassadorsUrl }}" style="display:inline-block;padding:16px 25px;background:#209dd6;color:white;text-decoration:none;border-radius:30px;font-size:15px;font-weight:bold;letter-spacing:.4px">{{ goToQueueButton }} &rarr;</a></td></tr>{% if currentMysteryImageUrl != blank %}<tr><td style="background:#f4f8fb;padding:26px 32px;"><h2 style="font-size:19px;margin:0 0 12px;color:#121b39">Current mystery</h2><table role="presentation" cellpadding="0" cellspacing="0"><tr><td width="110" valign="top"><img width="100" alt="Current mystery" src="{{ currentMysteryImageUrl | biketag_image: 'm' }}" style="max-width:100%;height:auto;border-radius:8px"/></td><td valign="top" style="padding-left:14px;font-size:14px;line-height:1.5;color:#283C4B">{{ currentMysteryHint }}<br>{{ currentMysteryBlurb }}</td></tr></table></td></tr>{% endif %}<tr><td style="background:#ffffff;padding:0;"><img src="{{ host }}/images/email-illustrated-footer.png" alt="" width="600" style="width:100%;display:block;max-width:600px;height:auto"/></td></tr><tr><td style="background:#102341;padding:10px 32px 30px;"><p style="margin:0 0 9px;font-size:15px;font-weight:bold;color:#fff">Explore more at <a href="{{ gameHost }}" style="color:#56c8f2">BikeTag</a></p><p style="margin:0;font-size:12px;line-height:1.5;color:#d6e4f0">{{ footerText }}<br>You receive this message as a BikeTag ambassador.<br>{% if redditLink != blank %}<a href="{{ redditLink }}" style="color:#9ddfff">Reddit</a> &nbsp;{% endif %}{% if blueskyLink != blank %}<a href="{{ blueskyLink }}" style="color:#9ddfff">Bluesky</a> &nbsp;{% endif %}{% if instagramLink != blank %}<a href="{{ instagramLink }}" style="color:#9ddfff">Instagram</a>{% endif %}</p></td></tr></table></td></tr></table></body></html>