{% assign imageSize = 'l' %}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BikeTag notification</title><style>@media screen and (max-width:620px){.email-shell{width:100%!important}.email-shell td{box-sizing:border-box}}</style></head><body style="margin:0;padding:0;background:#eaf1f5;font-family:Arial,Helvetica,sans-serif"><div style="display:none;max-height:0;overflow:hidden;opacity:0">ROUND PUBLISHED: BikeTag update.</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eaf1f5"><tr><td align="center" style="padding:24px 10px"><table class="email-shell" role="presentation" cellpadding="0" cellspacing="0" width="600" style="width:600px;max-width:100%;border-collapse:collapse">{% include '_header' %}<tr><td style="background:#ffffff;padding:26px 32px;"><p style="margin:0 0 8px;color:#208bc5;letter-spacing:2px;font-size:12px;font-weight:bold">ROUND PUBLISHED</p><h1 style="margin:0 0 12px;color:#121b39;font-size:34px;line-height:1.15">A new round is live!</h1><p style="margin:0;color:#283C4B;font-size:18px;line-height:1.6">{{ roundPublishedText }}</p></td></tr><tr><td style="background:#ffffff;padding:8px 32px 18px;">{% if newBikeTagPost.mysteryImageUrl != blank %}<img src="{{ newBikeTagPost.mysteryImageUrl | biketag_image: imageSize }}" width="530" alt="New mystery tag photograph" style="width:100%;max-width:530px;height:auto;display:block;border-radius:12px"/>{% else %}<p>View the new mystery in the live round.</p>{% endif %}</td></tr><tr><td style="background:#ffffff;padding:26px 32px;"><p style="margin:0;color:#283C4B;font-size:15px;line-height:1.6">The new mystery is ready for riders. Check the live round and keep the game moving.</p></td></tr><tr><td style="background:#ffffff;padding:10px 32px 28px;"><a href="{{ ambassadorsUrl }}" style="display:inline-block;padding:16px 25px;background:#209dd6;color:white;text-decoration:none;border-radius:30px;font-size:15px;font-weight:bold;letter-spacing:.4px">OPEN AMBASSADOR DASHBOARD &rarr;</a></td></tr>{% include '_footer' %}</table></td></tr></table></body></html>