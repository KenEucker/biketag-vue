<!DOCTYPE html>
<html lang="en" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml">

<head>
    <style type="text/css">
        body {
            margin: 1em;
            padding: 3em;
        }

        @media only screen and (max-width: 480px) {
            .biketagIcon {
                text-align: center;
                max-width: 15em;
            }
        }
    </style>
</head>

<body>
    <table border="0" cellpadding="10" cellspacing="0" width="600">
        {% if logo %}
        <tr>
            <td align="center" width="50%" valign="top" class="middleColumnContent">
                <img src="{{ logo }}" class="biketagIcon" alt="{{ game }} BikeTag logo" width="96" style="display:block;max-width:120px;max-height:96px;width:auto;height:auto;border:0">
            </td>
        </tr>
        {% endif %}
        <tr>
            <td align="center" width="50%" valign="bottom" class="middleColumnContent">
                <h4>An error has occurred for the {{ game }} game.</h4>
                <p>You are getting this email because you are listed as an ambassador for this game (<a href="{{ host }}">{{ host }}</a>).</p>
            </td>
        </tr>
    </table>

    <table border="0" cellpadding="10" cellspacing="0" width="600">
        <tr>
            <td align="center" width="50%" valign="top" class="middleColumnContent">
                The player who submitted the error has an IP address of {{ playerIp }}.
                <br>
                This was the payload sent with the error:
                <br>
                <pre>{{ payload }}</pre>
            </td>
        </tr>
    </table>
    <p><img src="{{ host }}/images/email-logo.png" alt="BikeTag" width="40" style="display:block;width:40px;max-width:40px;height:auto;border:0" /></p>
</body>

</html>
